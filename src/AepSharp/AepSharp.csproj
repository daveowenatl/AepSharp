<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>AepSharp</PackageId>
    <Version>0.2.0</Version>
    <Authors>Dave Owen</Authors>
    <Description>A native C# reader for Adobe After Effects (.aep) project files: compositions, footage, layers, transforms with keyframes and interpolation, effects, masks, shape contents, text documents and styles, and expressions, from the RIFX binary format. No After Effects install or ExtendScript required. Builds on boltframe/aftereffects-aep-parser and py-aep (MIT).</Description>
    <PackageTags>after-effects;aep;adobe;parser;rifx;riff;nexrender;motion-graphics</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/daveowenatl/AepSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daveowenatl/AepSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Dave Owen</Copyright>
  </PropertyGroup>

  <!-- Symbols + SourceLink (built-in) for a debuggable published package -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AepSharp.Tests" />
    <InternalsVisibleTo Include="AepSharp.Tools" />
  </ItemGroup>

</Project>
